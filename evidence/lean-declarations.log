                H i z = NilBohr.setDensity (NilBohr.progressionPullback A a (q ^ B) N') N')
  (weight : ℤ → ℂ)
  (hweighted :
    ‖NilBohr.countingForm N M (NilBohr.positiveInterval N) P weight fun x z => if z ∈ A then 1 else 0‖ ≤ μ * v / 4)
  (hcompare :
    ‖(NilBohr.countingForm N M (NilBohr.positiveInterval N) P weight fun x z => if z ∈ A then 1 else 0) -
          ↑μ * NilBohr.countingForm N M (NilBohr.positiveInterval N) P (fun x => 1) fun x z => if z ∈ A then 1 else 0‖ ≤
      μ * v / 4)
  (hreg :
    ‖(NilBohr.countingForm N M (NilBohr.positiveInterval N) P (fun x => 1) fun i z => ↑(H i z)) -
          NilBohr.countingForm N M (NilBohr.positiveInterval N) P (fun x => 1) fun x z => if z ∈ A then 1 else 0‖ ≤
      v / 8)
  (hmodel :
    v ≤ ‖NilBohr.countingForm N M (NilBohr.positiveInterval N) P (fun x => 1) fun x => NilBohr.densityModel N δ‖)
  (hgain : ↑k * (2 * η * δ) * ((1 + η) * δ) ^ (k - 1) < 3 * v / 8) :
  ∃ a N',
    L ≤ ↑N' ∧
      Finset.image (fun x => a + ↑(q ^ B) * x) (NilBohr.positiveInterval N') ⊆ NilBohr.positiveInterval N ∧
        (1 + η) * δ * ↑N' ≤ ↑(NilBohr.progressionPullback A a (q ^ B) N').card
