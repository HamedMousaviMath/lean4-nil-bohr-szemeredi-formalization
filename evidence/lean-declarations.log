  (density logModulus logLength : State → ℝ) (s₀ : State) {η a b loss : ℝ} (hη : 0 < η) (ha : 0 ≤ a) (ha₁ : a ≤ 1)
  (hb : 0 ≤ b) (hloss : 0 ≤ loss) (h₀ : valid s₀) (hδ : 0 < density s₀)
  (hbound : ∀ (s : State), valid s → density s ≤ 1)
  (step :
    ∀ (i : ℕ) (s : State),
      i < NilBohr.densityIterationSteps η (density s₀) →
        valid s →
          (1 + η) ^ i * density s₀ ≤ density s →
            logModulus s ≤ b ^ i * logModulus s₀ →
              a ^ i * logLength s₀ - ↑i * loss ≤ logLength s →
