NilBohr.centered_primeAverage_of_sandwich (a : ℕ → ℂ) (u : ℕ → ℝ) (m B : ℝ) (hB : 0 ≤ B) (ha : ∀ (p : ℕ), ‖a p‖ ≤ B)
  (happrox :
    ∀ (ε : ℝ),
      0 < ε →
        ∃ l gap mₗ m₉,
          (∀ (p : ℕ), l p ≤ u p) ∧
            (∀ (p : ℕ), u p ≤ l p + gap p) ∧
              |mₗ - m| ≤ ε ∧
                m₉ ≤ ε ∧
                  Filter.Tendsto
                      (fun N => NilBohr.primeAverage (fun p => ↑(l p) * a p) N - ↑mₗ * NilBohr.primeAverage a N)
                      Filter.atTop (nhds 0) ∧
                    Filter.Tendsto (fun N => (∑ p ∈ NilBohr.primesThrough N, gap p) / ↑(NilBohr.primesThrough N).card)
                      Filter.atTop (nhds m₉)) :
  Filter.Tendsto (fun N => NilBohr.primeAverage (fun p => ↑(u p) * a p) N - ↑m * NilBohr.primeAverage a N) Filter.atTop
    (nhds 0)
