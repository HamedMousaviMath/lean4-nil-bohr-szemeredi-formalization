                                        p.natDegree ≤ d →
                                          let P₀ := {m ∈ P' | ↑D ∣ m};
                                          ‖NilBohr.phaseAverage P₀ (fun m => Φ (NilBohr.heisenbergOrbit α β (m - 1)))
                                                p‖ ≤
                                            2 * Real.log ↑X ^ (-A)
NilBohr.primeLocalPhase_of_literature {c₀ : ℝ} (hc₀ : 0 < c₀) (hc₁ : c₀ < 1 / 11)
  (hLit : NilBohr.PrimePhaseLiteratureInputs c₀) {α β : ℝ} (hα : NilBohr.BadlyApproximable α) {denom : ℕ → ℕ}
  (hβ : NilBohr.AdmissibleBetaDenominators β denom) {d : ℕ} (hd : 0 < d) (F : NilBohr.Circle → ℂ) {κ : NNReal}
  (hF : LipschitzWith κ F) : NilBohr.PrimeLocalPhase d (NilBohr.heisenbergPhase α β) F
NilBohr.primeModelReplacement_log_saving_of_kmtt {c₀ : ℝ} (hc₀ : 0 < c₀) (hc₀' : c₀ < 1 / 11)
  (hBanks : NilBohr.BanksRealZeroBound) (hAmbient : NilBohr.KMTTAmbientPrimeModel c₀)
  (hBernstein : NilBohr.BernsteinCircleLipschitzFourier) {d : ℕ} (hd : 0 < d)
  (hG : NilBohr.NormalizedGowersLaws (max 3 (d + 1))) (F : C(NilBohr.Circle, ℂ)) (L₀ : NNReal)
  (hF : LipschitzWith L₀ ⇑F) {B K L A E : ℝ} (hB : 0 ≤ B) (hK : 0 ≤ K) (hL : 0 ≤ L) (hA : 0 < A) (hE : 0 < E) :
  ∃ C,
    0 < C ∧
      ∀ᶠ (N : ℕ) in Filter.atTop,
        ∀ {q b : ℕ} {l r u : ℤ},
          0 < q →
            ↑q ≤ Real.log ↑N ^ L →
              ↑b ≤ B →
                let M := NilBohr.parameterLength N q d;
                let X := q * M + 1;
                Finset.Icc l r ⊆ NilBohr.positiveInterval M →
                  ↑M * Real.log ↑N ^ (-K) ≤ ↑(Finset.Icc l r).card →
                    ∀ (α β : ℝ) (Q : Polynomial ℝ),
                      Q.natDegree ≤ d →
                        let P' := Finset.image (fun y => ↑q * y + 1) (NilBohr.localProgression l r u (q ^ b));
                        let ε := Real.log ↑X ^ (-E);
                        ‖NilBohr.phaseAverage P'
                              (fun m =>
                                (NilBohr.mangoldtWeight m - NilBohr.cramerWeight (NilBohr.cramerCutoff c₀ X) m) *
                                  NilBohr.heisenbergCenteredTest (⇑F) ε (NilBohr.heisenbergOrbit α β (m - 1)))
                              Q‖ ≤
                          C * Real.log ↑X ^ (-A)
NilBohr.primePointwiseFor_of_primeLocalPhase.{u_1} {X : Type u_1} [MeasurableSpace X]
  (hPNT : NilBohr.PrimeNumberTheorem) (hMWW : NilBohr.MirekWanWrightPointwise X) (hTer : NilBohr.TeravainenFixedFamily)
  (V : ℝ → ℝ → ℤ → ℝ)
  (hp :
    ∀ (α β : ℝ),
      NilBohr.BadlyApproximable α →
        NilBohr.AdmissibleBeta β →
          ∀ (d : ℕ),
            0 < d → ∀ (F : NilBohr.Circle → ℂ), (∃ K, LipschitzWith K F) → NilBohr.PrimeLocalPhase d (V α β) F) :
  NilBohr.PrimePointwiseFor X V
NilBohr.primeProgression_as_affine {l r u : ℤ} {M q b : ℕ} (hq : 0 < q)
  (hI : Finset.Icc l r ⊆ NilBohr.positiveInterval M) (hP : (NilBohr.localProgression l r u (q ^ b)).Nonempty) :
  let P := NilBohr.localProgression l r u (q ^ b);
  let P' := Finset.image (fun y => ↑q * y + 1) P;
  P'.card = P.card ∧
    P' ⊆ NilBohr.positiveInterval (q * M + 1) ∧
      P' = NilBohr.localProgression (↑q * l + 1) (↑q * r + 1) (↑q * u + 1) (q ^ (b + 1)) ∧
        IsCoprime (↑q * u + 1) ↑(q ^ (b + 1)) ∧
          ↑(Finset.Icc l r).card / ↑(q ^ b) - 1 < ↑P'.card ∧
            ∃ a, P' = Finset.image (fun t => a + ↑(q ^ (b + 1)) * t) (NilBohr.positiveInterval P'.card)
NilBohr.primeProgression_mangoldt_seam_error (hScalar : NilBohr.ScalarHeisenbergObstruction) {α β : ℝ}
  (hα : NilBohr.BadlyApproximable α) {denom : ℕ → ℕ} (hβ : NilBohr.AdmissibleBetaDenominators β denom) {d : ℕ}
  (hd : 0 < d) (B K L A : ℝ) (hB : 0 ≤ B) (hK : 0 ≤ K) (hL : 0 < L) (hA : 0 < A) (F : NilBohr.Circle → ℂ)
  (hF : Continuous F) :
  ∃ C,
    0 < C ∧
      ∀ᶠ (N : ℕ) in Filter.atTop,
        ∀ {q b : ℕ} {l r u : ℤ},
          0 < q →
            ↑q ≤ Real.log ↑N ^ L →
              ↑b ≤ B →
                let M := NilBohr.parameterLength N q d;
                let X := q * M + 1;
                Finset.Icc l r ⊆ NilBohr.positiveInterval M →
                  ↑M * Real.log ↑N ^ (-K) ≤ ↑(Finset.Icc l r).card →
                    let P' := Finset.image (fun y => ↑q * y + 1) (NilBohr.localProgression l r u (q ^ b));
                    let ε := Real.log ↑X ^ (-(A + 2));
                    ∀ (p : Polynomial ℝ),
                      ‖NilBohr.phaseAverage P'
                            (fun m =>
                              NilBohr.mangoldtWeight m *
                                (F ↑(NilBohr.heisenbergPhase α β (m - 1)) - NilBohr.circleMean F -
                                  NilBohr.heisenbergCenteredTest F ε (NilBohr.heisenbergOrbit α β (m - 1))))
                            p‖ ≤
                        C * Real.log ↑X ^ (-A)
NilBohr.primeProgression_sieve_scales {d : ℕ} (hd : 0 < d) (B K L : ℝ) (hB : 0 ≤ B) (hK : 0 ≤ K) (hL : 0 ≤ L) :
  ∃ c,
    0 < c ∧
      ∀ᶠ (N : ℕ) in Filter.atTop,
        ∀ {q b : ℕ} {l r u : ℤ},
          0 < q →
            ↑q ≤ Real.log ↑N ^ L →
              ↑b ≤ B →
                let M := NilBohr.parameterLength N q d;
                let X := q * M + 1;
                Finset.Icc l r ⊆ NilBohr.positiveInterval M →
                  ↑M * Real.log ↑N ^ (-K) ≤ ↑(Finset.Icc l r).card →
                    let P := NilBohr.localProgression l r u (q ^ b);
                    let P' := Finset.image (fun y => ↑q * y + 1) P;
                    let T := K + (B + 1) * L;
                    P'.card = P.card ∧
                      P' ⊆ NilBohr.positiveInterval X ∧
                        Real.log ↑N / (2 * ↑d) ≤ Real.log ↑X ∧
                          Real.log ↑X ≤ 2 * Real.log ↑N ∧
                            c * ↑X * Real.log ↑X ^ (-T) ≤ ↑P'.card ∧
                              ∀ {D : ℕ},
                                0 < D →
                                  ↑D ≤ ↑X ^ (1 / 20000) →
                                    (q ^ (b + 1)).Coprime D →
                                      let P₀ := {m ∈ P' | ↑D ∣ m};
                                      ↑(q ^ (b + 1) * D) ≤ ↑X ^ (1 / 10000) ∧
                                        ↑X ^ (1 / 2) ≤ ↑P₀.card ∧
                                          ∃ z,
                                            P₀ =
                                              Finset.image (fun t => z + ↑(q ^ (b + 1) * D) * t)
                                                (NilBohr.positiveInterval P₀.card)
NilBohr.prime_model_replacement_centered_chart (S : ℕ) (hS : 3 ≤ S) (hG : NilBohr.NormalizedGowersLaws S)
  (hBernstein : NilBohr.BernsteinCircleLipschitzFourier) (F : C(NilBohr.Circle, ℂ)) (L₀ : NNReal)
  (hF : LipschitzWith L₀ ⇑F) :
  ∃ C,
    0 < C ∧
      ∀ (X D : ℕ) [inst : NeZero D],
        0 < X →
          ∀ (a b u₀ : ℤ),
            Finset.Icc a b ⊆ NilBohr.positiveInterval X →
              (NilBohr.localProgression a b u₀ D).Nonempty →
                ∀ (u : ℤ → ℂ) (ε α β : ℝ),
                  0 < ε →
                    ε < 1 / 16 →
                      ∀ (Q : Polynomial ℝ),
                        Q.natDegree < S →
                          let J := NilBohr.localProgression a b u₀ D;
                          ‖NilBohr.phaseAverage J
                                (fun m =>
                                  u m * NilBohr.heisenbergCenteredTest (⇑F) ε (NilBohr.heisenbergOrbit α β (m - 1)))
                                Q‖ ≤
                            C * (↑X / ↑J.card) * (2 + Real.log ↑X) / ε ^ 2 * NilBohr.normalizedGowers S 1 (↑X) u
NilBohr.product_local_linear_phases.{u_1} {ι : Type u_1} [Fintype ι] (P : ι → Polynomial ℤ) (x y : ℤ) (θ γ : ι → ℝ) :
  ∏ i, NilBohr.phase (θ i * ↑(x + Polynomial.eval y (P i)) + γ i) =
