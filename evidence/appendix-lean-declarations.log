                    (Summable fun n => ‖fourierCoeff (⇑F) n‖) →
                      ∀ (lo hi : ℝ),
                        2 * (hi - lo) < 1 →
                          (∀ t ∈ Set.Ico 0 1, χ ↑t ≠ 0 → t ∈ Set.Icc lo hi) →
