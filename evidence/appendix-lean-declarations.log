NilBohr.realBinomialPhase_exp_totalVariation_le {d K : ℕ} {m : ℤ} (hm : m ≠ 0) {B C : ℝ} (hC : 0 ≤ C)
  (hLip : ∀ (x y : ℝ), ‖NilBohr.phase x - NilBohr.phase y‖ ≤ C * |x - y|) (hK : 0 < K) (e : ℕ → ℝ)
  (he : ∀ i ∈ Finset.range d, |e (i + 1)| ≤ B / ↑K ^ (i + 1)) :
