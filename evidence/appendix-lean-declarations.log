  (hScalar : NilBohr.ScalarHeisenbergObstruction) {α β : ℝ} (hα : NilBohr.BadlyApproximable α) {denom : ℕ → ℕ}
  (hβ : NilBohr.AdmissibleBetaDenominators β denom) {c₀ : ℝ} (hc₀ : 0 < c₀) (hc₁ : c₀ < 1) {d : ℕ} (hd : 0 < d)
  {B K L A E : ℝ} (hB : 0 ≤ B) (hK : 0 ≤ K) (hL : 0 < L) (hA : 0 < A) (hE : 0 < E) (F : NilBohr.Circle → ℂ) {κ : NNReal}
  (hF : LipschitzWith κ F) :
