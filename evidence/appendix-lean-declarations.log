  ‖NilBohr.countingForm N M X P v f‖ ^ 2 ≤
    (∑ y ∈ NilBohr.positiveInterval M, ‖NilBohr.spatialSlice X P f y‖ ^ 2) / (↑N ^ 2 * ↑M)
NilBohr.countingForm_twoInput_le (N M d : ℕ) (X : Finset ℤ) (P : Fin 2 → Polynomial ℤ) (v : ℤ → ℂ) (f : Fin 2 → ℤ → ℂ)
  (hN : 0 < N) (hM : 0 < M) (hP : P 0 = 0) (hDegree : (P 1).natDegree ≤ d)
  (hv : NilBohr.OneBoundedOn (NilBohr.positiveInterval M) v) (hf : ∀ (i : Fin 2), NilBohr.OneBoundedOn X (f i))
  (hFs : ∀ (i : Fin 2), NilBohr.SupportedOn X (f i)) :
  ‖NilBohr.countingForm N M X P v f‖ ≤ ↑X.card / ↑N * NilBohr.phaseNorm (d + 1) (NilBohr.positiveInterval M) v
NilBohr.cramerSieve_correlation_bound (W offset step H D r : ℕ) (divisors : Finset ℕ) (hW : 0 < W) (hH : 0 < H)
  (hr : 0 < r) (hStep : step.Coprime W) (hDivisors : ∀ l ∈ divisors, l ∣ W ∧ l ≤ D) (lower upper : ℕ → ℝ) (test : ℕ → ℂ)
  (ε gap : ℝ) (hε : 0 ≤ ε) (hLower : ∀ l ∈ divisors, |lower l| ≤ 1) (hUpper : ∀ l ∈ divisors, |upper l| ≤ 1)
  (hBracket :
    ∀ t ∈ Finset.range H,
      NilBohr.sieveDivisorSum divisors (fun l t => l ∣ offset + step * t) lower t ≤
          NilBohr.coprimeSieveIndicator W (offset + step * t) ∧
        NilBohr.coprimeSieveIndicator W (offset + step * t) ≤
          NilBohr.sieveDivisorSum divisors (fun l t => l ∣ offset + step * t) upper t)
  (hTest : ∀ t ∈ Finset.range H, ‖test t‖ ≤ 1) (hGap : ∑ l ∈ divisors, (upper l - lower l) / ↑l ≤ gap)
  (hGood :
    ∀ l ∈ divisors,
      ¬r ∣ l →
        ‖∑ t ∈ {t ∈ Finset.range H | l ∣ offset + step * t}, test t‖ ≤
          ε * ↑{t ∈ Finset.range H | l ∣ offset + step * t}.card) :
  ‖(∑ t ∈ Finset.range H, ↑(NilBohr.coprimeSieveIndicator W (offset + step * t)) * test t) / ↑H‖ ≤
    ε * (1 + Real.log ↑(max D 1)) + (1 + Real.log ↑(max D 1)) / ↑r + gap / 2 + (2 + ε) * (↑divisors.card / ↑H)
NilBohr.cramerWeight_eq_sieveIndicator {Q q : ℕ} (hQ : 2 ≤ Q) (m : ℤ) (hmq : m.toNat.Coprime q) :
  NilBohr.cramerWeight Q m =
    ↑(∏ p ∈ NilBohr.primesThrough Q, (1 - (↑p)⁻¹)⁻¹) *
      ↑(NilBohr.coprimeSieveIndicator (NilBohr.cramerSieveModulus Q q) m.toNat)
NilBohr.cubeDifference_heisenberg_of_short (α β lo hi : ℝ) (hs : 2 * (hi - lo) < 1) (steps : List ℤ) (n : ℤ)
  (horder : 3 ≤ steps.length) (h : NilBohr.cubeEvery steps (fun t => Int.fract (β * ↑t) ∈ Set.Icc lo hi) n) :
  NilBohr.cubeDifference steps (NilBohr.heisenbergPhase α β) n = 0
NilBohr.densityIncrementFor_of_relativeSelectorComparison (hreg : NilBohr.KMTTLocalWeakRegularity) {ℓ : ℕ}
  (P : Fin (ℓ + 1) → Polynomial ℤ) (hP : NilBohr.FixedPolynomialFamily P) {c₀ C : ℝ} (hc₀ : 0 < c₀) (hC : 1 ≤ C)
  (hcoeff : ∀ (i : Fin (ℓ + 1)), i ≠ 0 → NilBohr.HasCoefficients C 1 (P i)) (V : ℤ → ℝ) (J : NilBohr.OpenArc)
  (F : NilBohr.Circle → ℝ) (hsupp : tsupport F ⊆ J.carrier) (hF : ∀ (x : NilBohr.Circle), 0 ≤ F x ∧ F x ≤ 1)
  (hμ : 0 < ∫ (x : AddCircle 1), F x ∂AddCircle.haarAddCircle)
  (hcmp : NilBohr.RelativeSelectorComparison c₀ C (P (Fin.last ℓ)).natDegree ℓ V fun x => ↑(F x)) :
  NilBohr.DensityIncrementFor P fun p => J.Contains (V (↑p - 1))
NilBohr.density_increment_atom_from_count_inputs {k N M q B : ℕ} (hN : 0 < N) (P : Fin k → Polynomial ℤ) (A : Finset ℤ)
  (H : Fin k → ℤ → ℝ) {δ η μ v L : ℝ} (hδ : 0 ≤ δ) (hη : 0 ≤ η) (hμ : 0 < μ) (hH₀ : ∀ (i : Fin k) (z : ℤ), 0 ≤ H i z)
  (hHsupp : ∀ (i : Fin k), ∀ z ∉ NilBohr.positiveInterval N, H i z = 0)
  (hmass : ∀ (i : Fin k), ∑ z ∈ NilBohr.positiveInterval N, H i z = ↑N * δ)
  (hatom :
    ∀ (i : Fin k),
      ∀ z ∈ NilBohr.positiveInterval N,
        ∃ a N',
          0 < N' ∧
            L ≤ ↑N' ∧
              Finset.image (fun x => a + ↑(q ^ B) * x) (NilBohr.positiveInterval N') ⊆ NilBohr.positiveInterval N ∧
                H i z = NilBohr.setDensity (NilBohr.progressionPullback A a (q ^ B) N') N')
  (weight : ℤ → ℂ)
  (hweighted :
    ‖NilBohr.countingForm N M (NilBohr.positiveInterval N) P weight fun x z => if z ∈ A then 1 else 0‖ ≤ μ * v / 4)
  (hcompare :
    ‖(NilBohr.countingForm N M (NilBohr.positiveInterval N) P weight fun x z => if z ∈ A then 1 else 0) -
          ↑μ * NilBohr.countingForm N M (NilBohr.positiveInterval N) P (fun x => 1) fun x z => if z ∈ A then 1 else 0‖ ≤
      μ * v / 4)
  (hreg :
    ‖(NilBohr.countingForm N M (NilBohr.positiveInterval N) P (fun x => 1) fun i z => ↑(H i z)) -
          NilBohr.countingForm N M (NilBohr.positiveInterval N) P (fun x => 1) fun x z => if z ∈ A then 1 else 0‖ ≤
      v / 8)
  (hmodel :
    v ≤ ‖NilBohr.countingForm N M (NilBohr.positiveInterval N) P (fun x => 1) fun x => NilBohr.densityModel N δ‖)
  (hgain : ↑k * (2 * η * δ) * ((1 + η) * δ) ^ (k - 1) < 3 * v / 8) :
  ∃ a N',
    L ≤ ↑N' ∧
      Finset.image (fun x => a + ↑(q ^ B) * x) (NilBohr.positiveInterval N') ⊆ NilBohr.positiveInterval N ∧
        (1 + η) * δ * ↑N' ≤ ↑(NilBohr.progressionPullback A a (q ^ B) N').card
NilBohr.density_iteration_contradiction.{u_1} {State : Type u_1} (valid : State → Prop)
  (density logModulus logLength : State → ℝ) (s₀ : State) {η a b loss : ℝ} (hη : 0 < η) (ha : 0 ≤ a) (ha₁ : a ≤ 1)
  (hb : 0 ≤ b) (hloss : 0 ≤ loss) (h₀ : valid s₀) (hδ : 0 < density s₀)
  (hbound : ∀ (s : State), valid s → density s ≤ 1)
  (step :
    ∀ (i : ℕ) (s : State),
      i < NilBohr.densityIterationSteps η (density s₀) →
        valid s →
          (1 + η) ^ i * density s₀ ≤ density s →
            logModulus s ≤ b ^ i * logModulus s₀ →
              a ^ i * logLength s₀ - ↑i * loss ≤ logLength s →
                ∃ t,
                  valid t ∧
                    (1 + η) * density s ≤ density t ∧
                      logModulus t ≤ b * logModulus s ∧ a * logLength s - loss ≤ logLength t) :
  False
NilBohr.density_model_count_lower {k N M : ℕ} (hN : 0 < N) (hM : 0 < M) (P : Fin k → Polynomial ℤ) (Y : Finset ℤ)
  (hY : Y ⊆ NilBohr.positiveInterval M) (hshift : ∀ y ∈ Y, ∀ (i : Fin k), |Polynomial.eval y (P i)| ≤ ↑(N / 4)) {δ : ℝ}
  (hδ : 0 ≤ δ) :
  ↑Y.card / (2 * ↑M) * δ ^ k ≤
    ‖NilBohr.countingForm N M (NilBohr.positiveInterval N) P (fun x => 1) fun x => NilBohr.densityModel N δ‖
NilBohr.ergodicSequence_circleRotationExtension.{u_1} {X : Type u_1} [MeasurableSpace X] {μ : MeasureTheory.Measure X}
  [MeasureTheory.IsFiniteMeasure μ] (T : NilBohr.ProbabilitySystem X μ) {ℓ : ℕ} (Q : Fin ℓ → Polynomial ℤ)
  (f : Fin ℓ → X → ℂ) (i₁ i₂ : Fin ℓ) (ω₁ ω₂ : ℝ) (n : ℤ) (x : X) (t : NilBohr.Circle × NilBohr.Circle) :
  NilBohr.ergodicSequence (NilBohr.circleRotationExtension T ω₁ ω₂) Q (NilBohr.rotationInputs f i₁ i₂) n (x, t) =
    NilBohr.circleCharacter t.1 * NilBohr.circleCharacter t.2 *
      (NilBohr.phase (ω₁ * ↑(Polynomial.eval n (Q i₁)) + ω₂ * ↑(Polynomial.eval n (Q i₂))) *
        NilBohr.ergodicSequence T Q f n x)
NilBohr.eval_rescalePolynomial (q : ℤ) (P : Polynomial ℤ) (hP : P.coeff 0 = 0) (y : ℤ) :
