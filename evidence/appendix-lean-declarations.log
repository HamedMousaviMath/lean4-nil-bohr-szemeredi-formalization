                                ∀ (Φ : NilBohr.HeisenbergPoint → ℂ),
                                  NilBohr.HeisenbergLipschitzNormLE Φ (Real.log ↑X ^ E) →
                                    (∀ (x y : ℝ), ∫ (z : ℝ) in 0 ..1, Φ (x, y, z) = 0) →
