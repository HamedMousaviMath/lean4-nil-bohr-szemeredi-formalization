NilBohr.bohr_rotation_eigenfunction_example (hV : NilBohr.VinogradovPrimeEquidistribution) {θ ε : ℝ} (hθ : Irrational θ)
  (hε : 0 < ε) (hhalf : ε < 1 / 2) (t : ℝ) :
  let a := fun p => NilBohr.phase (t + θ * (↑p - 1));
  let s := ↑(Real.sin (2 * Real.pi * ε) / (2 * Real.pi * ε));
  Filter.Tendsto (NilBohr.primeAverage a) Filter.atTop (nhds 0) ∧
    Filter.Tendsto (NilBohr.selectedPrimeAverage (fun n => θ * ↑n) (NilBohr.symmetricBohrArc ε hε hhalf) a) Filter.atTop
        (nhds (NilBohr.phase t * s)) ∧
      NilBohr.phase t * s ≠ 0
