NilBohr.countingForm_separatingFamily_dilate {N M q : ℕ} (hN : 0 < N) (hM : 0 < M) (hq : 0 < q) (I : Finset ℤ)
  (v : ℤ → ℂ) (f : Fin 3 → ℤ → ℂ) :
  NilBohr.countingForm N M I (NilBohr.separatingFamily q) v f =
    ↑q ^ 2 *
      NilBohr.countingForm (q * N) (q * M) (Finset.image (fun x => ↑q * x) I) (NilBohr.separatingFamily 1)
        (NilBohr.dilatedWeight q v) fun i => NilBohr.dilatedWeight q (f i)
NilBohr.countingForm_separatingFamily_repeat {N M q : ℕ} (hN : 0 < N) (hM : 0 < M) (hq : 0 < q) (I : Finset ℤ)
  (v : ℤ → ℂ) (f : Fin 3 → ℤ → ℂ) :
  NilBohr.countingForm N M I (NilBohr.separatingFamily q) v f =
    ↑q *
      NilBohr.countingForm (q * N) (q * M) (NilBohr.repeatedSpatialWindow q I) (NilBohr.separatingFamily 1)
        (NilBohr.dilatedWeight q v) fun i x => f i (x / ↑q)
NilBohr.countingForm_sq_le_spatial_energy {k M N : ℕ} (hM : 0 < M) (X : Finset ℤ) (P : Fin k → Polynomial ℤ)
