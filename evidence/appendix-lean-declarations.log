      (NilBohr.separatingLength (r j) (r (j + 1)))
NilBohr.eventually_separatingScale {β : ℝ} {r : ℕ → ℕ} (hr : NilBohr.AdmissibleBetaDenominators β r) :
  ∀ᶠ (j : ℕ) in Filter.atTop, NilBohr.SeparatingScale (r j) (r (j + 1))
NilBohr.eventually_separatingStep {β : ℝ} {r : ℕ → ℕ} (hr : NilBohr.AdmissibleBetaDenominators β r) (B : ℕ) :
  ∀ᶠ (j : ℕ) in Filter.atTop,
    ↑(NilBohr.separatingModulus (r j) ^ (B + 1)) ≤
      (↑(NilBohr.separatingModulus (r j)) * ↑(NilBohr.separatingLength (r j) (r (j + 1)))) ^ (1 / 10000)
NilBohr.eventually_separating_test_length {q M : ℕ → ℕ} (hM : Filter.Tendsto M Filter.atTop Filter.atTop)
  (hq : ∀ᶠ (j : ℕ) in Filter.atTop, 0 < q j)
  (hqGrowth : ∀ (e : ℝ), 0 < e → ∀ᶠ (j : ℕ) in Filter.atTop, ↑(q j) ≤ ↑(M j) ^ e) {A₁ A₂ : ℝ} (hA₁ : 0 < A₁) (B : ℕ) :
  ∀ᶠ (j : ℕ) in Filter.atTop,
    ∀ (l r u : ℤ),
      ∀ b ≤ B,
        ↑(M j) * ↑(q j) ^ (-A₁) * (Real.log ↑(M j))⁻¹ ^ A₂ ≤ ↑(Finset.Icc l r).card →
          (NilBohr.localProgression l r u (q j ^ b)).Nonempty →
            (↑(q j) * ↑(M j)) ^ (1 / 2) ≤ ↑(NilBohr.localProgression l r u (q j ^ b)).card
NilBohr.eventually_siftedPhase_error {A : ℝ} (hA : 0 < A) :
  ∀ᶠ (X : ℕ) in Filter.atTop,
    1 ≤ Real.log ↑X ∧
      ∀ (D H r S : ℕ),
        ↑D ≤ ↑X ^ (1 / 20000) →
          ↑X ^ (1 / 2) ≤ ↑H →
            Real.log ↑X ^ (A + 2) ≤ ↑r →
              S ≤ D →
                let t := Real.log ↑X;
                let ε := 2 * t ^ (-(A + 2));
                ε * (1 + Real.log ↑(max D 1)) + (1 + Real.log ↑(max D 1)) / ↑r + t ^ (-(A + 1)) / 2 +
                    (2 + ε) * (↑S / ↑H) ≤
                  11 * t ^ (-(A + 1))
