                                  ↑X / ↑J.card * (2 + Real.log ↑X) *
                                      ((E * ∑' (n : ℤ), ‖fourierCoeff (⇑χ) n‖) * NilBohr.normalizedGowers S 1 (↑X) u) *
                                    ∑' (n : ℤ), ‖fourierCoeff (⇑F) n‖
