NilBohr.quantitativePrimeSelectorCutoffs :
  ∃ K,
    0 < K ∧
      ∀ (ε : ℝ),
        0 < ε →
          ε < 1 / 16 →
            ∃ pieces lo hi,
              (∀ (j : Fin 3),
                  ∃ κ,
                    LipschitzWith κ ⇑(pieces j) ∧
                      ‖pieces j‖ + ↑κ ≤ K / ε ^ 2 ∧
                        2 * (hi j - lo j) < 1 ∧ ∀ t ∈ Set.Ico 0 1, (pieces j) ↑t ≠ 0 → t ∈ Set.Icc (lo j) (hi j)) ∧
                ∀ (x : NilBohr.Circle), ∑ j, (pieces j) x = ↑(NilBohr.heisenbergSeamCutoff ε x)
