  (T : NilBohr.ProbabilitySystem X μ) {ℓ : ℕ} (P : Fin ℓ → Polynomial ℤ) (hP : NilBohr.ErgodicPolynomialFamily P)
  (f : Fin ℓ → X → ℂ) (hf : ∀ (i : Fin ℓ), MeasureTheory.MemLp (f i) ⊤ μ) (α β : ℝ) (hβ : NilBohr.AdmissibleBeta β)
  (hs :
    ∀ (S : NilBohr.ProbabilitySystem (X × NilBohr.Circle × NilBohr.Circle) (μ.prod NilBohr.twoTorusHaar)) {d : ℕ}
      (Q : Fin d → Polynomial ℤ),
      NilBohr.ErgodicPolynomialFamily Q → NilBohr.SmoothPrimeLimit S Q (NilBohr.heisenbergPhase α β))
  (h : ℤ) (hh : h ≠ 0) :
  ∀ᵐ (x : X) ∂μ,
    Filter.Tendsto
      (NilBohr.primeAverage fun p =>
        (fourier h) ↑(NilBohr.bracketPhase α β (↑p - 1)) * NilBohr.ergodicSequence T P f (↑p - 1) x)
      Filter.atTop (nhds 0)
