NilBohr.eval_rescalePolynomial_mul (q r : ℤ) (P : Polynomial ℤ) (hP : P.coeff 0 = 0) (hq : q ≠ 0) (y : ℤ) :
  r * Polynomial.eval y (NilBohr.rescalePolynomial (q * r) P) = Polynomial.eval (r * y) (NilBohr.rescalePolynomial q P)
NilBohr.eventually_cramerSieve_coefficients (hM : NilBohr.MertensIntervalProductBound)
  (hS : NilBohr.FundamentalSieveLemma) {c₀ A : ℝ} (hc₀ : 0 < c₀) (hc₁ : c₀ < 1) (hA : 0 < A) :
  ∀ᶠ (X : ℕ) in Filter.atTop,
    ∀ (q : ℕ),
      ∃ lower upper,
        NilBohr.SieveBracketingWeights (NilBohr.cramerSieveModulus (NilBohr.cramerCutoff c₀ X) q) ⌊↑X ^ (1 / 20000)⌋₊
          (Real.log ↑X ^ (-A)) lower upper
NilBohr.eventually_separatingLogModulus_logLogLength {β : ℝ} {r : ℕ → ℕ} (hr : NilBohr.AdmissibleBetaDenominators β r) :
  ∀ᶠ (j : ℕ) in Filter.atTop,
    let v := Real.log (Real.log ↑(NilBohr.separatingLength (r j) (r (j + 1))));
    v ^ 4 / 8 ≤ Real.log ↑(NilBohr.separatingModulus (r j)) ∧ Real.log ↑(NilBohr.separatingModulus (r j)) ≤ 16 * v ^ 4
NilBohr.eventually_separatingRelativeModulus {β : ℝ} {r : ℕ → ℕ} (hr : NilBohr.AdmissibleBetaDenominators β r)
  {c₀ cRel : ℝ} (hc₀ : 0 < c₀) (hcRel : 0 < cRel) (w₀ : ℕ) :
  ∀ᶠ (j : ℕ) in Filter.atTop,
    NilBohr.RelativeModulus c₀ cRel w₀ (NilBohr.separatingSpatialScale (r j) (r (j + 1)))
      (NilBohr.separatingModulus (r j)) (NilBohr.separatingW (r j))
NilBohr.eventually_separatingRelativeScaleWindow {β : ℝ} {r : ℕ → ℕ} (hr : NilBohr.AdmissibleBetaDenominators β r) :
