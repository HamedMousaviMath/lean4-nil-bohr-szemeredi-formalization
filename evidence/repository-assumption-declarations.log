  ∃ D,
    0 < D ∧
      (NilBohr.GreenTaoQuantitativeLeibman →
        ∀ (α β : ℝ),
          NilBohr.BadlyApproximable α →
            NilBohr.AdmissibleBeta β →
              ∀ (F : C(NilBohr.Circle, ℂ)) {κF : NNReal},
                LipschitzWith κF ⇑F →
                  ∀ (h : ℤ),
                    h ≠ 0 →
                      fourierCoeff (⇑F) h ≠ 0 →
                        ∀ (χ : C(NilBohr.Circle, ℝ)) {κχ : NNReal},
                          LipschitzWith κχ ⇑χ →
                            (∀ (x : NilBohr.Circle), 0 ≤ χ x) →
                              (∃ x, χ x ≠ 0) →
                                ∀ {lo hi : ℝ},
                                  0 < lo →
                                    hi < 1 →
                                      2 * (hi - lo) < 1 →
                                        (∀ x ∈ Set.Ico 0 1, χ ↑x ≠ 0 → x ∈ Set.Icc lo hi) →
                                          0 <
                                              ‖fourierCoeff (⇑F) h‖ *
                                                ∫ (x : AddCircle 1), χ x ∂AddCircle.haarAddCircle ∧
                                            ∀ᶠ (M : ℕ) in Filter.atTop,
                                              (‖fourierCoeff (⇑F) h‖ *
                                                    ∫ (x : AddCircle 1), χ x ∂AddCircle.haarAddCircle) /
                                                  2 ≤
                                                (D * ∑' (k : ℤ), ‖fourierCoeff (fun x => ↑(χ x)) k‖) *
                                                  NilBohr.normalizedGowers 3 1 ↑M fun n =>
                                                    F ↑(NilBohr.heisenbergPhase α β n) - NilBohr.circleMean ⇑F)
