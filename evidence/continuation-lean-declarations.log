NilBohr.primeDivisors_heisenberg_log_saving (hGT : NilBohr.ProductHeisenbergObstruction)
  (hScalar : NilBohr.ScalarHeisenbergObstruction) {α β : ℝ} (hα : NilBohr.BadlyApproximable α) {denom : ℕ → ℕ}
  (hβ : NilBohr.AdmissibleBetaDenominators β denom) {d : ℕ} (hd : 0 < d) {B K L A E : ℝ} (hB : 0 ≤ B) (hK : 0 ≤ K)
  (hL : 0 < L) (hA : 0 < A) (hE : 0 < E) :
  ∀ᶠ (N : ℕ) in Filter.atTop,
    ∀ {q b : ℕ} {l r u : ℤ},
      0 < q →
        ↑q ≤ Real.log ↑N ^ L →
          ↑b ≤ B →
            let M := NilBohr.parameterLength N q d;
            let X := q * M + 1;
            Finset.Icc l r ⊆ NilBohr.positiveInterval M →
              ↑M * Real.log ↑N ^ (-K) ≤ ↑(Finset.Icc l r).card →
                let P' := Finset.image (fun y => ↑q * y + 1) (NilBohr.localProgression l r u (q ^ b));
                ∃ j,
                  ↑(denom j) ≤ ↑X ^ (1 / 100) ∧
                    ↑X ^ (1 / 100) < ↑(denom (j + 1)) ∧
                      ∀ {D : ℕ},
                        0 < D →
                          ↑D ≤ ↑X ^ (1 / 20000) →
                            (q ^ (b + 1)).Coprime D →
                              ¬denom j ∣ D →
                                ∀ (Φ : NilBohr.HeisenbergPoint → ℂ),
                                  NilBohr.HeisenbergLipschitzNormLE Φ (Real.log ↑X ^ E) →
                                    (∀ (x y : ℝ), ∫ (z : ℝ) in 0 ..1, Φ (x, y, z) = 0) →
                                      ∀ (p : Polynomial ℝ),
                                        p.natDegree ≤ d →
                                          let P₀ := {m ∈ P' | ↑D ∣ m};
                                          ‖NilBohr.phaseAverage P₀ (fun m => Φ (NilBohr.heisenbergOrbit α β (m - 1)))
                                                p‖ ≤
                                            2 * Real.log ↑X ^ (-A)
