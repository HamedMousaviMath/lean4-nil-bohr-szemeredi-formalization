NilBohr.norm_heisenbergTwistedAverage_le_of_product_obstruction (hGT : NilBohr.ProductHeisenbergObstruction) (d : ℕ)
  (hd : 0 < d) :
  ∃ C D C₁,
    1 ≤ C ∧
      0 < D ∧
        0 ≤ C₁ ∧
          ∀ (α β U δ ε τ : ℝ) (a : ℤ) (v K : ℕ) (Φ : NilBohr.HeisenbergPoint → ℂ) (poly : Polynomial ℝ),
            0 < v →
              1 < K →
                0 < δ →
                  δ < 1 / 2 →
                    0 ≤ ε →
                      0 ≤ τ →
                        NilBohr.HeisenbergLipschitzNormLE Φ U →
                          poly.natDegree ≤ d →
                            let H := C * δ ^ (-D);
                            (∀ (k l : ℤ),
                                k ≠ 0 ∨ l ≠ 0 →
                                  max |↑k| |↑l| ≤ H → H < ↑K * NilBohr.torusNorm (↑v * (↑k * α + ↑l * β))) →
                              (∀ (k l m : ℤ),
                                  m ≠ 0 →
                                    max |↑k| (max |↑l| |↑m|) ≤ H →
                                      ∀ r < m.natAbs * d.factorial,
                                        ∀ (J : ℕ),
                                          τ ≤ ↑J →
                                            ‖NilBohr.heisenbergOrbitAverage α β
                                                  (a + ↑v * (↑r + 1 - ↑(m.natAbs * d.factorial)))
                                                  (v * (m.natAbs * d.factorial)) m.natAbs J
                                                  (NilBohr.heisenbergCoverTest Φ k l m)‖ ≤
                                              ε) →
                                ‖(NilBohr.heisenbergTwistedSum Φ α β a (↑v) K fun t => Polynomial.eval (↑t) poly) /
                                      ↑K‖ ≤
                                  max (δ * U) ((1 + C₁ * (↑d * H)) * (ε + H * ↑d.factorial * τ * U / ↑K))
