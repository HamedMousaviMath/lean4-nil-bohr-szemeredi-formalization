NilBohr.localized_prime_model_replacement_progression (S : ℕ) (hS : 3 ≤ S) (hG : NilBohr.NormalizedGowersLaws S) :
  ∃ E,
    0 < E ∧
      ∀ (X D : ℕ) [inst : NeZero D],
        0 < X →
          ∀ (a b u₀ : ℤ),
            Finset.Icc a b ⊆ NilBohr.positiveInterval X →
              (NilBohr.localProgression a b u₀ D).Nonempty →
                ∀ (u : ℤ → ℂ) (χ : C(NilBohr.Circle, ℂ)),
