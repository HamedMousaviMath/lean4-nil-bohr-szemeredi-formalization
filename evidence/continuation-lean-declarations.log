NilBohr.density_increment_atom_from_count_inputs {k N M q B : ℕ} (hN : 0 < N) (P : Fin k → Polynomial ℤ) (A : Finset ℤ)
  (H : Fin k → ℤ → ℝ) {δ η μ v L : ℝ} (hδ : 0 ≤ δ) (hη : 0 ≤ η) (hμ : 0 < μ) (hH₀ : ∀ (i : Fin k) (z : ℤ), 0 ≤ H i z)
  (hHsupp : ∀ (i : Fin k), ∀ z ∉ NilBohr.positiveInterval N, H i z = 0)
  (hmass : ∀ (i : Fin k), ∑ z ∈ NilBohr.positiveInterval N, H i z = ↑N * δ)
  (hatom :
    ∀ (i : Fin k),
      ∀ z ∈ NilBohr.positiveInterval N,
        ∃ a N',
          0 < N' ∧
            L ≤ ↑N' ∧
              Finset.image (fun x => a + ↑(q ^ B) * x) (NilBohr.positiveInterval N') ⊆ NilBohr.positiveInterval N ∧
                H i z = NilBohr.setDensity (NilBohr.progressionPullback A a (q ^ B) N') N')
  (weight : ℤ → ℂ)
  (hweighted :
    ‖NilBohr.countingForm N M (NilBohr.positiveInterval N) P weight fun x z => if z ∈ A then 1 else 0‖ ≤ μ * v / 4)
  (hcompare :
    ‖(NilBohr.countingForm N M (NilBohr.positiveInterval N) P weight fun x z => if z ∈ A then 1 else 0) -
          ↑μ * NilBohr.countingForm N M (NilBohr.positiveInterval N) P (fun x => 1) fun x z => if z ∈ A then 1 else 0‖ ≤
      μ * v / 4)
  (hreg :
    ‖(NilBohr.countingForm N M (NilBohr.positiveInterval N) P (fun x => 1) fun i z => ↑(H i z)) -
          NilBohr.countingForm N M (NilBohr.positiveInterval N) P (fun x => 1) fun x z => if z ∈ A then 1 else 0‖ ≤
      v / 8)
  (hmodel :
    v ≤ ‖NilBohr.countingForm N M (NilBohr.positiveInterval N) P (fun x => 1) fun x => NilBohr.densityModel N δ‖)
  (hgain : ↑k * (2 * η * δ) * ((1 + η) * δ) ^ (k - 1) < 3 * v / 8) :
  ∃ a N',
    L ≤ ↑N' ∧
      Finset.image (fun x => a + ↑(q ^ B) * x) (NilBohr.positiveInterval N') ⊆ NilBohr.positiveInterval N ∧
        (1 + η) * δ * ↑N' ≤ ↑(NilBohr.progressionPullback A a (q ^ B) N').card
NilBohr.density_iteration_contradiction.{u_1} {State : Type u_1} (valid : State → Prop)
  (density logModulus logLength : State → ℝ) (s₀ : State) {η a b loss : ℝ} (hη : 0 < η) (ha : 0 ≤ a) (ha₁ : a ≤ 1)
  (hb : 0 ≤ b) (hloss : 0 ≤ loss) (h₀ : valid s₀) (hδ : 0 < density s₀)
  (hbound : ∀ (s : State), valid s → density s ≤ 1)
  (step :
    ∀ (i : ℕ) (s : State),
      i < NilBohr.densityIterationSteps η (density s₀) →
        valid s →
          (1 + η) ^ i * density s₀ ≤ density s →
            logModulus s ≤ b ^ i * logModulus s₀ →
              a ^ i * logLength s₀ - ↑i * loss ≤ logLength s →
                ∃ t,
                  valid t ∧
                    (1 + η) * density s ≤ density t ∧
                      logModulus t ≤ b * logModulus s ∧ a * logLength s - loss ≤ logLength t) :
  False
NilBohr.density_model_count_lower {k N M : ℕ} (hN : 0 < N) (hM : 0 < M) (P : Fin k → Polynomial ℤ) (Y : Finset ℤ)
