NilBohr.weighted_local_inverse_of_kmtt (hInv : NilBohr.KMTTLocalInverse) {C : ℝ} (hC : 1 ≤ C) {d ℓ : ℕ} (hd : 0 < d)
  (hℓ : 0 < ℓ) :
  ∃ K₀ D₀ c₁ D₁ c₂ D₂ B₀,
    0 < K₀ ∧
      0 < D₀ ∧
        0 < c₁ ∧
          0 < D₁ ∧
            0 < c₂ ∧
              0 < D₂ ∧
                ∀ (N q : ℕ),
                  3 ≤ N →
                    0 < q →
                      ↑q ≤ Real.exp (Real.log ↑N ^ (1 / 10)) →
                        let M := NilBohr.parameterLength N q d;
                        0 < M →
                          ∀ (P : Fin (ℓ + 1) → Polynomial ℤ),
                            NilBohr.FixedPolynomialFamily P →
                              (P (Fin.last ℓ)).natDegree = d →
                                (∀ (i : Fin (ℓ + 1)), i ≠ 0 → NilBohr.HasCoefficients C q (P i)) →
                                  ∀ (v : ℤ → ℂ) (f : Fin (ℓ + 1) → ℤ → ℂ),
                                    NilBohr.OneBoundedOn (NilBohr.positiveInterval M) v →
                                      (∀ (i : Fin (ℓ + 1)), NilBohr.OneBoundedOn (NilBohr.spatialInterval C N) (f i)) →
                                        (∀ (i : Fin (ℓ + 1)), NilBohr.SupportedOn (NilBohr.spatialInterval C N) (f i)) →
                                          ∀ (δ : ℝ),
                                            0 < δ →
                                              δ < 1 / 2 →
                                                δ ≤ ‖NilBohr.countingForm N M (NilBohr.spatialInterval C N) P v f‖ →
                                                  ↑N ≤ K₀ * δ ^ (-D₀) ∨
                                                    ∀ (i : Fin (ℓ + 1)),
                                                      i ≠ 0 →
                                                        ∃ V s γ,
                                                          0 < V ∧
                                                            c₁ * ↑M ^ (P i).natDegree * (↑q / δ) ^ (-D₁) ≤ ↑V ∧
                                                              V ≤ M ^ (P i).natDegree ∧
                                                                q ^ B₀ * V ≤ N ∧
                                                                  c₂ * δ ^ D₂ * ↑N ≤
                                                                    ‖∑ x ∈ NilBohr.spatialInterval C N,
                                                                        f i x *
                                                                          NilBohr.localBlockPhase (q ^ B₀) V s γ x‖
