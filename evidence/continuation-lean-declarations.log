NilBohr.cramerSieve_correlation_bound (W offset step H D r : ℕ) (divisors : Finset ℕ) (hW : 0 < W) (hH : 0 < H)
  (hr : 0 < r) (hStep : step.Coprime W) (hDivisors : ∀ l ∈ divisors, l ∣ W ∧ l ≤ D) (lower upper : ℕ → ℝ) (test : ℕ → ℂ)
  (ε gap : ℝ) (hε : 0 ≤ ε) (hLower : ∀ l ∈ divisors, |lower l| ≤ 1) (hUpper : ∀ l ∈ divisors, |upper l| ≤ 1)
  (hBracket :
    ∀ t ∈ Finset.range H,
      NilBohr.sieveDivisorSum divisors (fun l t => l ∣ offset + step * t) lower t ≤
          NilBohr.coprimeSieveIndicator W (offset + step * t) ∧
        NilBohr.coprimeSieveIndicator W (offset + step * t) ≤
          NilBohr.sieveDivisorSum divisors (fun l t => l ∣ offset + step * t) upper t)
  (hTest : ∀ t ∈ Finset.range H, ‖test t‖ ≤ 1) (hGap : ∑ l ∈ divisors, (upper l - lower l) / ↑l ≤ gap)
  (hGood :
    ∀ l ∈ divisors,
      ¬r ∣ l →
        ‖∑ t ∈ {t ∈ Finset.range H | l ∣ offset + step * t}, test t‖ ≤
          ε * ↑{t ∈ Finset.range H | l ∣ offset + step * t}.card) :
  ‖(∑ t ∈ Finset.range H, ↑(NilBohr.coprimeSieveIndicator W (offset + step * t)) * test t) / ↑H‖ ≤
    ε * (1 + Real.log ↑(max D 1)) + (1 + Real.log ↑(max D 1)) / ↑r + gap / 2 + (2 + ε) * (↑divisors.card / ↑H)
