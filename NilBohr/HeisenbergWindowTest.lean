import NilBohr.GreenTaoScalarMetric
import NilBohr.HeisenbergWindow

/-! A continuous test realizing the introductory Heisenberg nil-Bohr set. -/

namespace NilBohr

open Set

/-- The complexified distance to the closed complement of the window. -/
noncomputable def heisenbergWindowTest (J : OpenArc) : C(HeisenbergNilmanifold, ℂ) := by
  letI : MetricSpace HeisenbergNilmanifold := heisenbergNilmanifoldMetric
  exact ⟨fun x => (Metric.infDist x (heisenbergWindow J)ᶜ : ℝ),
    Complex.continuous_ofReal.comp (Metric.continuous_infDist_pt _)⟩

theorem heisenbergWindowTest_re_pos_iff (J : OpenArc) (x : HeisenbergNilmanifold) :
    0 < (heisenbergWindowTest J x).re ↔ x ∈ heisenbergWindow J := by
  letI : MetricSpace HeisenbergNilmanifold := heisenbergNilmanifoldMetric
  have hclosed : IsClosed (heisenbergWindow J)ᶜ := (isOpen_heisenbergWindow J).isClosed_compl
  have hnonempty : ((heisenbergWindow J)ᶜ).Nonempty := by
    refine ⟨heisenbergQuotientProjection (0, 0, 0), ?_⟩
    simp [heisenbergQuotientProjection_mem_window, Int.fract]
  change 0 < (↑(Metric.infDist x (heisenbergWindow J)ᶜ) : ℂ).re ↔ x ∈ heisenbergWindow J
  rw [Complex.ofReal_re, ← hclosed.not_mem_iff_infDist_pos hnonempty, not_mem_compl_iff]

/-- The preimage of the open right half-plane is precisely the window. -/
theorem heisenbergWindowTest_preimage (J : OpenArc) :
    heisenbergWindowTest J ⁻¹' {z : ℂ | 0 < z.re} = heisenbergWindow J :=
  Set.ext (heisenbergWindowTest_re_pos_iff J)

/-- The orbit producing the selector is polynomial for the rational lower
central filtration already checked in the Heisenberg model. -/
theorem heisenbergTranslation_isFilteredPolynomial (α β : ℝ) :
    IsFilteredPolynomial HeisenbergGroup.lowerCentral
      (fun n : ℤ => (⟨α, β, 0⟩ : HeisenbergGroup) ^ n) := by
  have heq : (fun n : ℤ => (⟨α, β, 0⟩ : HeisenbergGroup) ^ n) =
      (fun n => HeisenbergGroup.coordinates.symm (dilatedHeisenbergOrbit α β 1 (0 + 1 * n))) := by
    funext n
    apply HeisenbergGroup.coordinates.injective
    rw [coordinates_heisenbergTranslation_zpow, Equiv.apply_symm_apply]
    simp [dilatedHeisenbergOrbit]
  rw [heq]
  exact HeisenbergGroup.dilatedProgression_isFilteredPolynomial α β 1 (by decide) 0 1

/-- The basic polynomial nilsequence for the window restriction. -/
noncomputable def heisenbergWindowNilsequence (α β : ℝ) (J : OpenArc) (n : ℤ) : ℂ :=
  heisenbergWindowTest J (QuotientGroup.mk ((⟨α, β, 0⟩ : HeisenbergGroup) ^ n))

/-- The exact return condition at every integer time includes the horizontal seam. -/
theorem heisenbergWindowNilsequence_re_pos_iff (α β : ℝ) (J : OpenArc) (n : ℤ) :
    0 < (heisenbergWindowNilsequence α β J n).re ↔
      0 < Int.fract ((n : ℝ) * β) ∧ J.Contains (heisenbergPhase α β n) := by
  unfold heisenbergWindowNilsequence
  rw [heisenbergWindowTest_re_pos_iff, ← HeisenbergGroup.coordinates.symm_apply_apply
    ((⟨α, β, 0⟩ : HeisenbergGroup) ^ n), coordinates_heisenbergTranslation_zpow]
  exact heisenbergOrbit_mem_window_iff α β J n

/-- At each nonzero time, irrationality removes the seam condition. -/
theorem heisenbergWindowNilsequence_re_pos_iff_of_irrational (α : ℝ) {β : ℝ}
    (hβ : Irrational β) (J : OpenArc) {n : ℤ} (hn : n ≠ 0) :
    0 < (heisenbergWindowNilsequence α β J n).re ↔ J.Contains (heisenbergPhase α β n) := by
  unfold heisenbergWindowNilsequence
  rw [heisenbergWindowTest_re_pos_iff, ← HeisenbergGroup.coordinates.symm_apply_apply
    ((⟨α, β, 0⟩ : HeisenbergGroup) ^ n), coordinates_heisenbergTranslation_zpow]
  exact heisenbergOrbit_mem_window_iff_of_irrational α hβ J hn

/-- The basic polynomial nilsequence tests exactly the shifted-prime selector. -/
theorem heisenbergWindowNilsequence_prime_re_pos_iff (α : ℝ) {β : ℝ}
    (hβ : AdmissibleBeta β) (J : OpenArc) {p : ℕ} (hp : p.Prime) :
    0 < (heisenbergWindowNilsequence α β J ((p : ℤ) - 1)).re ↔
      J.Contains (heisenbergPhase α β ((p : ℤ) - 1)) := by
  apply heisenbergWindowNilsequence_re_pos_iff_of_irrational α hβ.liouville.irrational J
  have := hp.two_le
  omega

/-- The Heisenberg window is the preimage of an open complex set under
a continuous map, with return times generated by a filtered-polynomial orbit. -/
theorem heisenbergWindow_basicNilsequence (α β : ℝ) (J : OpenArc) :
    ∃ (g : ℤ → HeisenbergGroup) (F : C(HeisenbergNilmanifold, ℂ)) (U : Set ℂ),
      IsFilteredPolynomial HeisenbergGroup.lowerCentral g ∧ IsOpen U ∧
      F ⁻¹' U = heisenbergWindow J ∧
      ∀ n : ℤ, heisenbergWindowNilsequence α β J n = F (QuotientGroup.mk (g n)) := by
  exact ⟨fun n => (⟨α, β, 0⟩ : HeisenbergGroup) ^ n, heisenbergWindowTest J,
    {z : ℂ | 0 < z.re}, heisenbergTranslation_isFilteredPolynomial α β,
    isOpen_lt continuous_const Complex.continuous_re, heisenbergWindowTest_preimage J,
    fun _ => rfl⟩

end NilBohr
